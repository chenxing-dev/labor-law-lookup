#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<'EOF'
Usage: ./scrape <TITLE>

Resolve a law title in a browser session and run the spider.
EOF
}

TITLE=""

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	*)
		TITLE="${TITLE:+$TITLE }$1"
		shift
		;;
	esac
done

if [[ $# -gt 0 ]]; then
	TITLE="${TITLE:+$TITLE }$*"
fi

TITLE="${TITLE# }"
TITLE="${TITLE% }"

if [[ -z "$TITLE" ]]; then
	echo "A law title is required." >&2
	usage >&2
	exit 2
fi

exec "python" "spiders/law_spider.py" --title "$TITLE" --headless
